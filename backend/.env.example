# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=WevyDB
DB_NAME=wevy

# Server
PORT=3000
NODE_ENV=development

# Gmail (pour l'envoi des emails de reset)
GMAIL_USER=ton.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Groq (extraction de recettes depuis TikTok/Instagram - gratuit, dispo en Europe)
# Clé gratuite : https://console.groq.com/keys
GROQ_API_KEY=...

# Firebase Admin (pour vérifier les tokens)
FIREBASE_PROJECT_ID=your-project-id
# Vous devrez ajouter firebase-adminsdk.json dans le dossier config/

GMAIL_USER=user@gmail.com
GMAIL_APP_PASSWORD=app_password
